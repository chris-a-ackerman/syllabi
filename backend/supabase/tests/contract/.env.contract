# Extra env for `supabase functions serve` during contract tests. No secrets —
# every asserted path rejects before any Anthropic call, so a dummy key is fine.
# ANON_KEY / SERVICE_ROLE_KEY are appended at runtime from `supabase status -o env`
# (see tests/contract/serve-env.sh and the contract job in ci.yml).
ANTHROPIC_API_KEY=dummy-key-contract-tests
# SYL-29 size-cap tests upload a 2 KiB file and expect a rejection. Keep in
# sync with SERVE_MAX_SYLLABUS_BYTES in tests/contract/quota.test.ts.
MAX_SYLLABUS_BYTES=1024
# SYL-72: test-canvas-token's "not connected" 404 path, and manage-api-keys'
# get/store/delete_anthropic_key round trips, need a value here to get past
# the "Server misconfiguration" guard — this is a symmetric-encryption key
# used only inside this ephemeral local stack, not a real secret. Keep in
# sync with the ENC_KEY constant in tests/contract/manage-api-keys.test.ts
# and tests/contract/chat.test.ts.
CANVAS_ENCRYPTION_KEY=contract_test_enc_key
SECRETS_ENCRYPTION_KEY=contract_test_enc_key
